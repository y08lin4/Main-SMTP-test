{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smtp-tester-online",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "vars": {
    "APP_VERSION": "v0.1.0",
    "GITHUB_URL": "https://github.com/y08lin4/smtp-tester-online"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
