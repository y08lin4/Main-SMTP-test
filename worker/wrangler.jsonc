{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smtp-tester-online",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "REPORT_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 12, "period": 60 }
    }
  ],
  "vars": {
    "APP_VERSION": "dev",
    "GITHUB_URL": "https://github.com/y08lin4/Main-SMTP-test",
    "DOWNLOAD_URL": "",
    "PUBLIC_BASE_URL": "",
    "MAIL_TESTER_USERNAME": "",
    "MAIL_TESTER_INBOX_DOMAIN": ""
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
